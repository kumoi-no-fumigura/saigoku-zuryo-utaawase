 "poems": [
  {
   "seq": "1",
   "text": "春の池にひとへ殘れるうす氷あをもたまもゝ隱れさりけり",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "うく氷のこりすくなく成にけり池のかゝみと冬はみしかと",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "春風やぬるく吹らむ池水のみきはの氷ひとへのこれり",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "にほとりもみなそこ深くかよふめり池ほの氷むら〓〓にして",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "まちかうも花橘の木をうゑて古き年よりみそならしつる",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "なにまさる花橘を頭挿にてさかゆる君かみよとこそみれ",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "我を祈る〓とはよのつね立花の年ふる程のかすはまされり",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "峯をこえ吹くる程の松風は千とせとのみそとほく聞ゆる",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "千代の音をえたちならねと聞えける峯をこえ吹谷のまつ風",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "遠近の峯の松風わがずしていづれの方も千代とふくなり",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "ことし植てみるかおかしさうひに咲花のえた〓〓紅にして",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "色ふかくわきてか露の置つらんけさうひにさく初花のいろ",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "もと末にことのはをやはしたるへき紅色は深さまされり",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "澤水になひくまこものすゑしけみゆく我駒のたちとまりつゝ",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "春駒のすたきはてゝしまこも草みきはも茂みおひにけるかな",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "まこも草茂さぞまさる春駒のすだきはてゝし汀おとれり",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "我君の御代なかひこの苗をしもひきつらねてもうゝるたこ哉",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "常よりも今年はとに手もたゆく苗ひきそふる田子のいとなみ",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "おのかしゝ手每にともすみかり人のをたひノ〓のしるくもある哉",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "夏山はともしのまつのたひ〓とに鹿のたちとそさやけかりける",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "鹿のすむたちどはふりて狩人の手每に燈す數はまされり",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "夏冬の神を祭ると急きしにはかなくきねの年はおいつゝ",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "みな人のこのて柏を捧けつゝまつらんくにの神そさかえむ",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "きれもいさ兒手柏をさしはてゝ人の祭れる神は畏こし",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "ひをみてはみなくる虫もある物をふすふ計りに踈むかやなそ",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "夕されはほのにふすふる蚊遣火の下こかれつゝ上はつれなき",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "夕されにされとみゆれど蚊遣火のふすぶる人は思ひ增れり",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "わたつみの神にとはゝや釣舟の浮たるよをはいつよりかへし",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "たなゝしのあまの釣舟波まよりとわたる程そはるけかりける",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "うきてふる事ははかなし釣船の遙けき程の渡りまされり",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "あま人のかた〓〓にやくしほかまの煙たえせぬ君か御代かな",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "あまたやく人や住らんしほかまの煙たえせすみゆる浦かな",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "あまた燒く浦も遙けし鹽竈の煙たえせぬかたもおとらす",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "年をへて色もかはらぬ吳竹のふしにも千代をこめてけるかな",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "節每に千代をこめたる竹なれはかはらぬ色は君そみるへき",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "網代にてひをのみくらす宇治人は年のよるをそ歎かさりける",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "ひをへつゝ散もみちはもこの里は網代によりてみるそ嬉しき",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "とふ人もなき山里の槇のとはあられのみこそ嬉しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "降かゝる音はおとろく霰かな旅の宿りのいたやなれはか",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "風さむみとこさへさゆる冬のよは池の氷もとちやますらむ",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "おとは川遠かた人も袖たれてわたるはかりに氷しにけり",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "つの國の難波わたりはしらねとも蘆をしるへに尋ねてそゆく",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
